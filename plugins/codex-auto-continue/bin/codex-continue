#!/bin/sh
# Codex Auto Continue launcher (macOS / Linux).
# Resolves this plugin's bundled Python package and runs the CLI.
set -eu

here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
root=$(CDPATH= cd -- "$here/.." && pwd)

if [ -n "${CODEX_AUTO_CONTINUE_PYTHON:-}" ]; then
  py=$CODEX_AUTO_CONTINUE_PYTHON
else
  py=""
  for candidate in python3 python; do
    if command -v "$candidate" >/dev/null 2>&1; then
      py=$candidate
      break
    fi
  done
fi

if [ -z "$py" ]; then
  echo "codex-auto-continue: Python 3.9+ was not found (python3/python)." >&2
  exit 127
fi

if [ -n "${PYTHONPATH:-}" ]; then
  PYTHONPATH="$root/lib:$PYTHONPATH"
else
  PYTHONPATH="$root/lib"
fi
export PYTHONPATH
exec "$py" -m codex_auto_continue "$@"
